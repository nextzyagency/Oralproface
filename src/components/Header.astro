---
import { Image } from "astro:assets";
import logo from "../assets/logos/oralproface_fondo_transparente.png";

const links = [
  { href: "#inicio", label: "Inicio" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#implante", label: "El implante" },
  { href: "#servicios", label: "Servicios" },
  { href: "#testimonios", label: "Resultados" },
  { href: "#faq", label: "Preguntas" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 px-3 sm:px-5 pt-3 transition-all duration-500">
  <div
    id="header-bar"
    class="mx-auto max-w-7xl flex items-center justify-between gap-4 rounded-full border border-white/60 bg-white/70 backdrop-blur-xl px-3 sm:px-4 py-2 shadow-[0_8px_30px_-12px_rgba(15,76,129,0.25)] transition-all duration-500"
  >
    <a href="#inicio" class="flex items-center shrink-0" aria-label="Oral ProFace - Inicio">
      <span class="logo-crop block h-10 sm:h-11">
        <Image src={logo} alt="Oral ProFace" width={360} loading="eager" />
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            data-nav
            class="nav-link relative px-4 py-2 rounded-full text-sm font-medium text-slate-600 hover:text-medical-blue transition-colors"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="#cita"
        class="hidden sm:inline-flex group items-center gap-2 rounded-full bg-medical-blue pl-5 pr-2 py-2 text-sm font-semibold text-white shadow-lg shadow-medical-blue/25 hover:bg-primary transition-colors"
      >
        Agendar cita
        <span class="grid place-items-center w-7 h-7 rounded-full bg-lime text-ink group-hover:rotate-[-35deg] transition-transform">
          <span class="material-symbols-rounded text-[18px]">arrow_forward</span>
        </span>
      </a>
      <button
        id="mobile-menu-btn"
        class="lg:hidden grid place-items-center w-11 h-11 rounded-full bg-medical-gray text-medical-blue"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="material-symbols-rounded text-[26px]" id="menu-icon">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden mx-auto max-w-7xl mt-2 origin-top rounded-3xl border border-white/60 bg-white/95 backdrop-blur-xl shadow-2xl p-3 hidden"
  >
    <nav class="flex flex-col" aria-label="Menú móvil">
      {
        links.map((l, i) => (
          <a
            href={l.href}
            class="flex items-center justify-between px-4 py-3.5 rounded-2xl text-base font-medium text-slate-700 hover:bg-medical-gray hover:text-medical-blue transition-colors"
          >
            <span>
              <span class="text-xs font-bold text-primary/60 mr-3">0{i + 1}</span>
              {l.label}
            </span>
            <span class="material-symbols-rounded text-slate-300">chevron_right</span>
          </a>
        ))
      }
      <a
        href="#cita"
        class="mt-2 flex items-center justify-center gap-2 rounded-2xl bg-lime py-4 font-bold text-ink"
      >
        <span class="material-symbols-rounded">calendar_month</span>
        Agendar valoración
      </a>
    </nav>
  </div>
</header>

<style>
  /* Logo PNG has wide transparent margins: crop to the artwork. */
  .logo-crop {
    aspect-ratio: 920 / 550;
    overflow: hidden;
  }
  .logo-crop :global(img) {
    width: 117.4%;
    max-width: none;
    height: auto;
    margin-left: -12.2%;
    margin-top: -27.7%;
  }
  .nav-link.is-active {
    color: var(--color-medical-blue);
    background: rgb(23 138 193 / 0.1);
  }
  #site-header.is-scrolled #header-bar {
    background: rgb(255 255 255 / 0.9);
  }
  #site-header.is-hidden {
    transform: translateY(-120%);
  }
  /* Compact mode (mobile, over the 3D implant): the bar collapses left → right until only the menu button remains */
  #header-bar {
    clip-path: inset(0 0 0 0 round 9999px);
    transition: clip-path 0.6s cubic-bezier(0.65, 0, 0.35, 1), background 0.5s, box-shadow 0.5s;
  }
  #header-bar > :not(:last-child) {
    transition: opacity 0.35s ease;
  }
  @media (max-width: 1023.98px) {
    #site-header.is-compact #header-bar {
      clip-path: inset(0 0 0 calc(100% - 70px) round 9999px);
    }
    #site-header.is-compact #header-bar > :not(:last-child) {
      opacity: 0;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header")!;
  const btn = document.getElementById("mobile-menu-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const icon = document.getElementById("menu-icon")!;

  const setMenu = (open: boolean) => {
    menu.classList.toggle("hidden", !open);
    icon.textContent = open ? "close" : "menu";
    btn.setAttribute("aria-expanded", String(open));
  };
  btn.addEventListener("click", () => setMenu(menu.classList.contains("hidden")));
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));

  // Hide on scroll down, show on scroll up
  const implantSection = document.getElementById("implante");
  let lastY = window.scrollY;
  window.addEventListener(
    "scroll",
    () => {
      const y = window.scrollY;
      header.classList.toggle("is-scrolled", y > 20);
      const menuOpen = !menu.classList.contains("hidden");
      // Collapse to just the menu button while the 3D implant section is pinned
      const r = implantSection?.getBoundingClientRect();
      const compact = !!r && r.top < 80 && r.bottom > window.innerHeight * 0.6;
      header.classList.toggle("is-compact", compact);
      header.classList.toggle("is-hidden", y > lastY && y > 400 && !menuOpen && !compact);
      lastY = y;
    },
    { passive: true }
  );

  // Active section highlight
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav]"));
  const sections = navLinks
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute("href")!))
    .filter(Boolean) as HTMLElement[];
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        navLinks.forEach((a) => a.classList.toggle("is-active", a.getAttribute("href") === `#${e.target.id}`));
      });
    },
    { rootMargin: "-45% 0px -50% 0px" }
  );
  sections.forEach((s) => io.observe(s));
</script>
