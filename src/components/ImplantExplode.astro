---
import DentalIcon from "./DentalIcon.astro";

const steps = [
  {
    icon: "view_in_ar",
    kicker: "Implante de una sola pieza",
    title: "Una raíz nueva, en una sola pieza",
    text: "Sigue bajando y descubre cómo es el implante dental que usamos y por qué es la solución más parecida a un diente natural.",
  },
  {
    icon: "verified",
    kicker: "Titanio biocompatible",
    title: "Se une a tu hueso, para durar",
    text: "El titanio es biocompatible y se integra al hueso como una raíz natural, ayudando a conservarlo. Con buenos cuidados, es una solución a largo plazo.",
  },
  {
    icon: "restaurant",
    kicker: "Rosca de anclaje",
    title: "Muerde con total firmeza",
    text: "Su rosca se ancla con firmeza al hueso desde el primer día. Vuelve a comer carne, frutas y lo que te guste, sin miedo.",
  },
  {
    icon: "lock",
    kicker: "Pilar integrado",
    title: "Nada se mueve, nada se cae",
    text: "El pilar forma parte del mismo implante: sin tornillos ni uniones que se aflojen. Olvídate de adhesivos y prótesis que bailan.",
  },
  {
    icon: "bolt",
    kicker: "Carga inmediata",
    title: "Tus dientes fijos en 72 horas",
    text: "Con implantología estratégica colocamos tus dientes fijos en tiempo récord, incluso si te han dicho que no tienes suficiente hueso.",
  },
];
---

<section id="implante" class="relative bg-ink text-white" style="height: 480svh;">
  <div class="sticky top-0 h-[100svh] overflow-clip">
    <!-- Ambient background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_50%,rgba(23,138,193,0.35),transparent_60%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_10%_100%,rgba(166,214,8,0.12),transparent_50%)]"></div>
      <div
        class="absolute inset-0 opacity-[0.07]"
        style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse at 70% 50%, black 10%, transparent 70%);"
      >
      </div>
    </div>

    <div class="relative h-full mx-auto max-w-7xl px-5 sm:px-8 grid grid-rows-[auto_1fr] lg:grid-rows-1 lg:grid-cols-2 gap-2 lg:gap-10">
      <!-- 3D stage (right on desktop, top on mobile) -->
      <div class="relative order-1 lg:order-2 h-[36svh] lg:h-full mt-16 lg:mt-0">
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[70%] aspect-square rounded-full bg-primary/25 blur-[90px]" aria-hidden="true"></div>
        <div id="implant-stage" class="absolute inset-0"></div>

        <!-- Fallback (no WebGL) -->
        <div id="implant-fallback" class="hidden absolute inset-0 place-items-center">
          <DentalIcon name="implant" class="h-[70%] w-auto drop-shadow-2xl" />
        </div>

        <div id="implant-loading" class="absolute inset-0 grid place-items-center text-white/50 text-sm">
          <span class="flex items-center gap-2"><span class="w-4 h-4 rounded-full border-2 border-white/30 border-t-lime animate-spin"></span> Cargando modelo 3D…</span>
        </div>
      </div>

      <!-- Copy -->
      <div class="relative order-2 lg:order-1 flex flex-col justify-start lg:justify-center pb-6 lg:pb-0">
        <span class="hidden lg:inline-flex w-fit items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-lime">
          <span class="material-symbols-rounded text-[16px]">deployed_code</span> El implante por dentro
        </span>

        <!-- Steps -->
        <div class="relative mt-2 lg:mt-8 min-h-[17rem] lg:min-h-[22rem]">
          {
            steps.map((s, i) => (
              <article class="impl-step absolute inset-x-0 top-0" data-step={i} aria-hidden={i === 0 ? "false" : "true"}>
                <div class="flex items-center gap-3">
                  <span class="grid place-items-center w-10 h-10 lg:w-12 lg:h-12 rounded-2xl bg-lime text-ink shadow-lg shadow-lime/20">
                    <span class="material-symbols-rounded">{s.icon}</span>
                  </span>
                  <span class="text-xs lg:text-sm font-bold uppercase tracking-[0.18em] text-lime">{s.kicker}</span>
                </div>
                <h2 class="mt-3 lg:mt-5 font-display text-2xl sm:text-3xl lg:text-5xl font-bold leading-tight">{s.title}</h2>
                <p class="mt-3 lg:mt-5 text-sm sm:text-base lg:text-lg leading-relaxed text-white/70 max-w-lg">{s.text}</p>
                {i === steps.length - 1 && (
                  <a
                    href="#cita"
                    class="mt-4 lg:mt-7 inline-flex items-center gap-2 rounded-full bg-lime px-5 py-2.5 lg:px-6 lg:py-3 text-sm lg:text-base font-bold text-ink hover:bg-white transition-colors"
                  >
                    Quiero mi valoración <span class="material-symbols-rounded">arrow_forward</span>
                  </a>
                )}
              </article>
            ))
          }
        </div>

        <!-- Progress -->
        <div class="mt-4 lg:mt-10 flex items-center gap-3">
          <div class="flex gap-1.5 flex-1 max-w-sm">
            {steps.map((_, i) => <span class="impl-dot h-1.5 flex-1 rounded-full bg-white/15 overflow-hidden"><span class="block h-full w-0 bg-lime" /></span>)}
          </div>
          <span id="impl-counter" class="font-display text-sm font-semibold text-white/60 tabular-nums">01 / 0{steps.length}</span>
        </div>
        <p class="hidden lg:flex mt-6 items-center gap-2 text-sm text-white/40">
          <span class="material-symbols-rounded text-[18px] animate-bounce">swipe_down</span> Desplázate para explorar el implante
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .impl-step {
    opacity: 0;
    transform: translateY(24px);
    filter: blur(6px);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.5s ease;
    pointer-events: none;
  }
  .impl-step.is-active {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }
  .impl-step.is-past {
    transform: translateY(-24px);
  }
</style>

<script>
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { gsap } from "gsap";
  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById("implante")!;
  const stage = document.getElementById("implant-stage")!;
  const loading = document.getElementById("implant-loading")!;
  const fallback = document.getElementById("implant-fallback")!;
  const stepsEls = Array.from(section.querySelectorAll<HTMLElement>(".impl-step"));
  const dots = Array.from(section.querySelectorAll<HTMLElement>(".impl-dot > span"));
  const counter = document.getElementById("impl-counter")!;
  const N = stepsEls.length;

  let scene: ReturnType<typeof import("../scripts/implant3d").createImplantScene> | null = null;
  let progress = 0;
  let current = -1;

  function setStep(i: number) {
    if (i === current) return;
    current = i;
    stepsEls.forEach((el, k) => {
      el.classList.toggle("is-active", k === i);
      el.classList.toggle("is-past", k < i);
      el.setAttribute("aria-hidden", String(k !== i));
    });
    counter.textContent = `0${i + 1} / 0${N}`;
  }

  function update(p: number) {
    progress = p;
    scene?.setProgress(p);
    const i = Math.min(N - 1, Math.floor(p * N * 0.999));
    setStep(i);
    dots.forEach((d, k) => {
      const local = Math.min(1, Math.max(0, p * N - k));
      d.style.width = `${local * 100}%`;
    });
  }

  ScrollTrigger.create({
    trigger: section,
    start: "top top",
    end: "bottom bottom",
    onUpdate: (self) => update(self.progress),
  });
  update(0);

  async function boot() {
    try {
      const probe = document.createElement("canvas");
      if (!(probe.getContext("webgl2") || probe.getContext("webgl"))) throw new Error("no webgl");
      const { createImplantScene } = await import("../scripts/implant3d");
      scene = createImplantScene(stage);
      scene.setProgress(progress);

      loading.remove();
      const io = new IntersectionObserver(([e]) => (e.isIntersecting ? scene!.start() : scene!.stop()), { rootMargin: "100px" });
      io.observe(section);
    } catch {
      loading.remove();
      fallback.classList.remove("hidden");
      fallback.classList.add("grid");
    }
  }

  // Load Three.js only when the section approaches the viewport
  const pre = new IntersectionObserver(
    ([e]) => {
      if (e.isIntersecting) {
        pre.disconnect();
        boot();
      }
    },
    { rootMargin: "600px" }
  );
  pre.observe(section);
</script>
