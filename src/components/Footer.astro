---
const links = [
  { href: "#nosotros", label: "Nosotros" },
  { href: "#implante", label: "El implante" },
  { href: "#servicios", label: "Servicios" },
  { href: "#testimonios", label: "Resultados" },
  { href: "#faq", label: "Preguntas" },
  { href: "#contacto", label: "Contacto" },
];
---

<footer class="relative bg-ink border-t border-white/10 text-white/60">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 py-14 grid gap-10 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl font-bold text-white">Oral<span class="text-primary">Pro</span><span class="text-lime">Face</span></p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed">Implantología estratégica y carga inmediata. Recuperamos sonrisas donde otros dijeron que no era posible.</p>
    </div>
    <nav aria-label="Pie de página">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-white/40">Navegación</p>
      <ul class="mt-4 grid grid-cols-2 gap-2 text-sm">
        {links.map((l) => <li><a class="hover:text-lime transition-colors" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-white/40">Síguenos</p>
      <div class="mt-4 flex gap-3">
        <a
          href="https://www.facebook.com/oralpoface"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="grid place-items-center w-11 h-11 rounded-full bg-white/5 border border-white/10 text-white hover:bg-primary hover:border-primary transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3Z" /></svg>
        </a>
        <a
          href="https://www.instagram.com/oralproface/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="grid place-items-center w-11 h-11 rounded-full bg-white/5 border border-white/10 text-white hover:bg-primary hover:border-primary transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-6 flex flex-col sm:flex-row justify-between gap-2 text-xs text-white/40">
      <p>Oral ProFace · Todos los derechos reservados {new Date().getFullYear()}</p>
      <p>Diseño y desarrollo por <span class="text-lime">Nextzy agency</span></p>
    </div>
  </div>
</footer>

<!-- Floating WhatsApp -->
<a
  href="https://wa.me/573103114580?text=Hola,%20deseo%20información%20sobre%20implantes."
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  class="fixed bottom-5 right-5 z-40 grid place-items-center w-14 h-14 rounded-full bg-[#25D366] text-white shadow-xl shadow-black/20 hover:scale-110 transition-transform"
>
  <span class="absolute inset-0 rounded-full bg-[#25D366] animate-pulse-ring" aria-hidden="true"></span>
  <svg class="relative w-7 h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3ZM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z" /></svg>
</a>
