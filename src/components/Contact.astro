---
import SideDecor from "./SideDecor.astro";
import { sedes } from "../data/site";

const inputCls =
  "peer w-full rounded-2xl border border-white/15 bg-white/[0.06] px-4 pt-6 pb-2 text-white placeholder-transparent outline-none transition-all focus:border-lime focus:bg-white/10";
const labelCls =
  "pointer-events-none absolute left-4 top-2 text-xs font-medium text-white/50 transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:text-xs peer-focus:text-lime";
---

<section id="contacto" class="relative bg-ink py-24 sm:py-32 overflow-clip">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 left-1/3 w-[40rem] h-[40rem] rounded-full bg-primary/20 blur-3xl"></div>
    <div class="absolute bottom-0 -right-20 w-80 h-80 rounded-full bg-lime/10 blur-3xl"></div>
  </div>
  <SideDecor
    items={[
      { name: "tooth", side: "left", top: "8%", size: 70, rotate: -10, speed: 0.4, offset: 20 },
      { name: "screw", side: "right", top: "40%", size: 38, rotate: -25, speed: 0.6, offset: 40 },
      { name: "sparkle", side: "right", top: "82%", size: 40, speed: 0.5, delay: 1, offset: 30, mobile: true },
    ]}
  />

  <div class="relative z-10 mx-auto max-w-7xl px-5 sm:px-8 grid lg:grid-cols-2 gap-12 lg:gap-16">
    <!-- Info -->
    <div class="text-white">
      <span data-reveal class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-lime">
        <span class="material-symbols-rounded text-[16px]">support_agent</span> Contacto y sedes
      </span>
      <h2 data-reveal class="mt-5 font-display text-3xl sm:text-4xl md:text-5xl font-bold leading-tight">
        Implantes dentales en <span class="italic text-lime">Barranquilla y Bogotá</span>
      </h2>
      <p data-reveal class="mt-4 max-w-md text-white/70">
        Atendemos en Barranquilla y Bogotá, Colombia, y en Maracaibo, Venezuela. Elige tu sede o escríbenos
        y te respondemos por WhatsApp.
      </p>

      <!-- Sede tabs -->
      <div data-reveal class="mt-8 inline-flex flex-wrap gap-1 rounded-full bg-white/5 border border-white/10 p-1" role="tablist" aria-label="Sedes">
        {
          sedes.map((s, i) => (
            <button
              type="button"
              role="tab"
              class="sede-tab rounded-full px-4 sm:px-5 py-2 text-sm font-semibold text-white/70 transition-colors aria-selected:bg-lime aria-selected:text-ink hover:text-white"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`sede-${i}`}
              data-tab={i}
            >
              {s.ciudad}
            </button>
          ))
        }
      </div>

      <div data-reveal class="mt-5">
        {
          sedes.map((s, i) => (
            <div id={`sede-${i}`} role="tabpanel" class:list={["sede-panel rounded-3xl border border-white/10 bg-white/[0.04] p-6 sm:p-7 backdrop-blur", i !== 0 && "hidden"]}>
              <div class="flex items-center gap-3">
                <span class="grid place-items-center w-12 h-12 rounded-2xl bg-primary/20 text-lime">
                  <span class="material-symbols-rounded">location_on</span>
                </span>
                <div>
                  <p class="font-display text-2xl font-bold">{s.ciudad}</p>
                  <p class="text-xs text-white/50">{s.pais}</p>
                </div>
              </div>
              <ul class="mt-6 space-y-4 text-white/80">
                <li class="flex gap-3">
                  <span class="material-symbols-rounded text-lime">map</span>
                  <a
                    class="hover:text-white"
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s.direccion + " " + s.ciudad)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {s.direccion}
                  </a>
                </li>
                <li class="flex gap-3">
                  <span class="material-symbols-rounded text-lime">call</span>
                  <a class="hover:text-white" href={`tel:+${s.tel.replace(/\s/g, "")}`}>+{s.tel}</a>
                </li>
                <li class="flex gap-3">
                  <span class="material-symbols-rounded text-lime">mail</span>
                  <a class="hover:text-white break-all" href={`mailto:${s.email}`}>{s.email}</a>
                </li>
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Form -->
    <div data-reveal class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-6 sm:p-8 backdrop-blur-sm h-fit lg:sticky lg:top-28">
      <h3 class="flex items-center gap-3 font-display text-xl font-bold text-white">
        <span class="grid place-items-center w-10 h-10 rounded-xl bg-[#25D366] text-white">
          <span class="material-symbols-rounded">chat</span>
        </span>
        Envíanos un mensaje
      </h3>
      <p class="mt-2 text-sm text-white/50">Al enviar se abrirá WhatsApp con tu mensaje listo.</p>
      <form id="contact-form" class="mt-6 space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="relative">
            <input class={inputCls} id="nombre" placeholder="Nombre" type="text" autocomplete="given-name" required />
            <label class={labelCls} for="nombre">Nombre</label>
          </div>
          <div class="relative">
            <input class={inputCls} id="apellidos" placeholder="Apellidos" type="text" autocomplete="family-name" required />
            <label class={labelCls} for="apellidos">Apellidos</label>
          </div>
        </div>
        <div class="relative">
          <input class={inputCls} id="email" placeholder="Correo" type="email" autocomplete="email" required />
          <label class={labelCls} for="email">Correo electrónico</label>
        </div>
        <div class="relative">
          <input class={inputCls} id="ciudad" placeholder="Ciudad" type="text" autocomplete="address-level2" required />
          <label class={labelCls} for="ciudad">Ciudad</label>
        </div>
        <div class="relative">
          <textarea class={`${inputCls} resize-none`} id="mensaje" placeholder="Mensaje" rows="5" required></textarea>
          <label class={labelCls} for="mensaje">¿En qué podemos ayudarte?</label>
        </div>
        <button
          class="group w-full inline-flex items-center justify-center gap-2 rounded-full bg-lime py-4 font-bold text-ink shadow-lg shadow-lime/20 hover:bg-white transition-colors"
          type="submit"
        >
          Contactar por WhatsApp
          <span class="material-symbols-rounded group-hover:translate-x-1 transition-transform">send</span>
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  // Sede tabs
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".sede-tab"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".sede-panel"));
  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      const i = Number(t.dataset.tab);
      tabs.forEach((x, k) => x.setAttribute("aria-selected", String(k === i)));
      panels.forEach((p, k) => p.classList.toggle("hidden", k !== i));
    })
  );

  // WhatsApp form
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const v = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
    const message = `Hola Oralproface, mi nombre es ${v("nombre")} ${v("apellidos")}. Mi correo es ${v("email")} y te escribo desde ${v("ciudad")}. Mi mensaje: ${v("mensaje")}`;
    window.open(`https://wa.me/573008990189?text=${encodeURIComponent(message)}`, "_blank");
  });
</script>
