---
import SideDecor from "./SideDecor.astro";

const wa = "https://wa.me/573103114580?text=Hola,%20deseo%20agendar%20una%20valoración%20de%20implantología.";
---

<section id="inicio" class="relative overflow-clip bg-gradient-to-b from-[#eef6fb] via-white to-background-light">
  <!-- Background shapes -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 -right-40 w-[38rem] h-[38rem] rounded-full bg-primary/15 blur-3xl"></div>
    <div class="absolute top-1/2 -left-40 w-[28rem] h-[28rem] rounded-full bg-lime/15 blur-3xl"></div>
    <div
      class="absolute inset-0 opacity-[0.05]"
      style="background-image: radial-gradient(#0F4C81 1px, transparent 1px); background-size: 26px 26px; mask-image: linear-gradient(to bottom, black, transparent 85%);"
    >
    </div>
  </div>

  <SideDecor
    items={[
      { name: "tooth", side: "left", top: "18%", size: 90, rotate: -12, speed: 0.4, offset: 18, mobile: true },
      { name: "sparkle", side: "left", top: "62%", size: 46, rotate: 10, speed: 0.8, delay: 1.2, offset: 40 },
      { name: "implant", side: "right", top: "70%", size: 70, rotate: 18, speed: 0.5, delay: 0.6, offset: 22, mobile: true },
    ]}
  />

  <div class="relative z-10 mx-auto max-w-7xl px-5 sm:px-8 pt-28 sm:pt-32 lg:pt-36 pb-16 lg:pb-24">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Copy -->
      <div class="lg:col-span-6 xl:col-span-6">
        <div class="hero-in inline-flex items-center gap-2 rounded-full border border-primary/20 bg-white/80 pl-1.5 pr-4 py-1.5 shadow-sm">
          <span class="grid place-items-center rounded-full bg-lime px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-ink">Precisión</span>
          <span class="text-xs sm:text-sm font-medium text-medical-blue">Implantología estratégica · Carga inmediata</span>
        </div>

        <h1 class="hero-in mt-6 font-display text-[2.6rem] leading-[1.05] sm:text-6xl xl:text-7xl font-bold tracking-tight text-ink">
          Vuelve a sonreír
          <span class="relative inline-block">
            <span class="text-gradient italic">sin miedo</span>
            <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 300 16" fill="none" preserveAspectRatio="none" aria-hidden="true">
              <path class="hero-underline" d="M3 12C70 4 180 2 297 9" stroke="#A6D608" stroke-width="5" stroke-linecap="round" />
            </svg>
          </span>
          <br class="hidden sm:block" /> con dientes fijos en 72&nbsp;horas.
        </h1>

        <p class="hero-in mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-slate-600">
          Implantes basales y estratégicos para pacientes que creían que no tenían solución.
          <strong class="text-ink font-semibold">Sin injertos óseos complejos</strong>, con planificación digital
          y un equipo que te acompaña en cada paso.
        </p>

        <div class="hero-in mt-8 flex flex-col sm:flex-row gap-3">
          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative inline-flex items-center justify-center gap-3 rounded-full bg-lime px-7 py-4 font-bold text-ink shadow-xl shadow-lime/30 hover:shadow-lime/50 hover:-translate-y-0.5 transition-all"
          >
            <span class="material-symbols-rounded">calendar_month</span>
            Agendar valoración
            <span class="material-symbols-rounded group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </a>
          <a
            href="#implante"
            class="group inline-flex items-center justify-center gap-3 rounded-full border border-slate-200 bg-white px-6 py-4 font-semibold text-ink hover:border-primary hover:text-primary transition-colors"
          >
            <span class="grid place-items-center w-8 h-8 rounded-full bg-primary/10 text-primary">
              <span class="material-symbols-rounded icon-fill text-[20px]">view_in_ar</span>
            </span>
            Ver el implante en 3D
          </a>
        </div>

        <!-- Trust row -->
        <div class="hero-in mt-10 grid grid-cols-3 max-w-lg divide-x divide-slate-200 rounded-2xl border border-slate-200/80 bg-white/70 backdrop-blur py-4 shadow-sm">
          <div class="px-4 text-center">
            <p class="font-display text-2xl sm:text-3xl font-bold text-medical-blue">+<span data-count="30">30</span></p>
            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Sonrisas transformadas</p>
          </div>
          <div class="px-4 text-center">
            <p class="font-display text-2xl sm:text-3xl font-bold text-medical-blue"><span data-count="72">72</span>h</p>
            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Dientes fijos</p>
          </div>
          <div class="px-4 text-center">
            <p class="font-display text-2xl sm:text-3xl font-bold text-medical-blue"><span data-count="3">3</span></p>
            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Sedes</p>
          </div>
        </div>
      </div>

      <!-- Visual collage -->
      <div class="lg:col-span-6 relative" data-parallax-scope>
        <div class="relative mx-auto w-full max-w-[34rem] aspect-[5/6]">
          <!-- Orbit rings -->
          <div class="absolute inset-[-6%] rounded-full border border-dashed border-primary/25 animate-[spin_60s_linear_infinite]" aria-hidden="true"></div>
          <div class="absolute inset-[6%] rounded-full border border-primary/10" aria-hidden="true"></div>

          <!-- Main arch image -->
          <div class="hero-img absolute inset-x-[10%] top-0 bottom-[6%] overflow-hidden rounded-t-[999px] rounded-b-[2.5rem] shadow-[0_40px_80px_-30px_rgba(15,76,129,0.55)] ring-8 ring-white">
            <img
              src="/imagenes/hero/imagen1.jpeg"
              alt="Paciente sonriendo tras su tratamiento de implantología en Oral ProFace"
              class="w-full h-full object-cover object-[50%_30%] scale-110"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-medical-blue/50 via-transparent to-transparent"></div>
          </div>

          <!-- Procedure thumbnail -->
          <div
            class="hero-card absolute -left-2 sm:-left-6 bottom-[14%] w-[38%] overflow-hidden rounded-3xl ring-4 ring-white shadow-2xl"
            data-speed="-0.15"
          >
            <img src="/imagenes/hero/imagen2.jpg" alt="Dr. Rixio Martínez realizando un procedimiento" class="aspect-square w-full object-cover" loading="eager" />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-ink/80 to-transparent p-3">
              <p class="text-[11px] sm:text-xs font-semibold text-white flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-lime animate-pulse"></span> Cirugía guiada
              </p>
            </div>
          </div>

          <!-- 72h card -->
          <div
            class="hero-card absolute -right-1 sm:-right-4 top-[16%] glass rounded-2xl p-3 sm:p-4 shadow-xl border border-white flex items-center gap-3"
            data-speed="0.2"
          >
            <div class="relative grid place-items-center w-11 h-11 rounded-xl bg-medical-blue text-white">
              <span class="material-symbols-rounded">timer</span>
            </div>
            <div>
              <p class="font-display font-bold text-ink leading-tight text-sm sm:text-base">Carga inmediata</p>
              <p class="text-xs text-slate-500">Sonríe en 72 horas</p>
            </div>
          </div>

          <!-- Result card -->
          <div
            class="hero-card absolute right-0 sm:-right-2 bottom-[2%] glass rounded-2xl p-2.5 pr-4 shadow-xl border border-white flex items-center gap-3"
            data-speed="0.1"
          >
            <img src="/imagenes/hero/imagen3.jpg" alt="Paciente con su nueva sonrisa" class="w-12 h-12 rounded-xl object-cover object-[50%_40%]" loading="eager" />
            <div>
              <div class="flex text-amber-400">
                {Array.from({ length: 5 }).map(() => <span class="material-symbols-rounded icon-fill text-[16px]">star</span>)}
              </div>
              <p class="text-xs font-semibold text-ink">Resultados reales</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <a href="#proposito" class="hidden lg:flex absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex-col items-center gap-2 text-xs font-medium text-slate-400 hover:text-primary transition-colors">
    Descubre más
    <span class="w-6 h-10 rounded-full border-2 border-current flex justify-center pt-2">
      <span class="w-1 h-2 rounded-full bg-current animate-bounce"></span>
    </span>
  </a>
</section>

<style>
  .hero-underline {
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: draw 1.2s 0.9s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
</style>

<script>
  import { gsap } from "gsap";
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
    tl.from(".hero-in", { y: 30, opacity: 0, duration: 0.9, stagger: 0.1 })
      .from(".hero-img", { clipPath: "inset(100% 0 0 0 round 2.5rem)", duration: 1.3, ease: "expo.out" }, 0.1)
      .from(".hero-img img", { scale: 1.35, duration: 1.8, ease: "expo.out" }, 0.1)
      .from(".hero-card", { opacity: 0, scale: 0.85, y: 20, duration: 0.8, stagger: 0.15, ease: "back.out(1.6)" }, 0.6);
  }
</script>
