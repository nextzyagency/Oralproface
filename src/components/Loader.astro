---
// Minimal preloader: a tooth outline that draws itself, an implant that settles in, and a progress line.
// Inline CSS/JS so it paints before any bundle loads.
---

<div id="loader" aria-hidden="true">
  <div class="loader-glow"></div>
  <svg class="loader-mark" viewBox="0 0 100 150" fill="none">
    <defs>
      <linearGradient id="loader-grad" x1="10" y1="0" x2="90" y2="150" gradientUnits="userSpaceOnUse">
        <stop stop-color="#178AC1" />
        <stop offset="1" stop-color="#A6D608" />
      </linearGradient>
    </defs>
    <path
      class="loader-tooth"
      d="M50 14C38 4 18 6 12 22 6 38 12 52 18 62c4 8 4 22 8 34 3 10 12 10 14 0 3-12 4-22 10-22s7 10 10 22c2 10 11 10 14 0 4-12 4-26 8-34 6-10 12-24 6-40C82 6 62 4 50 14Z"
      stroke="url(#loader-grad)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      pathLength="1"></path>
    <g class="loader-implant">
      <path d="M44 106h12l-1 4H45l-1-4Z" fill="#178AC1" />
      <path d="M43 112h14l-1 26c0 5-3 9-6 10-3-1-6-5-6-10l-1-26Z" fill="#178AC1" opacity=".9" />
      <path d="M43 118l14-2M43 124l14-2M43.5 130l13-2M44 136l12-2" stroke="#fff" stroke-width="1.4" stroke-linecap="round" opacity=".7" />
    </g>
  </svg>
  <div class="loader-bar"><span></span></div>
</div>

<style is:global>
  html.is-loading {
    overflow: hidden;
  }
  #loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 28px;
    background: #fbfcfd;
    transition: opacity 0.6s ease, transform 0.8s cubic-bezier(0.7, 0, 0.2, 1), visibility 0s linear 0.8s;
  }
  #loader.is-done {
    opacity: 0;
    transform: translateY(-3%);
    visibility: hidden;
    pointer-events: none;
  }
  .loader-glow {
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(23, 138, 193, 0.16), transparent 70%);
    animation: loader-breathe 2.4s ease-in-out infinite;
  }
  .loader-mark {
    position: relative;
    width: 76px;
    height: auto;
    overflow: visible;
  }
  .loader-tooth {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: loader-draw 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
  }
  .loader-implant {
    animation: loader-settle 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
  }
  .loader-bar {
    position: relative;
    width: 72px;
    height: 2px;
    border-radius: 2px;
    background: rgba(15, 76, 129, 0.1);
    overflow: hidden;
  }
  .loader-bar span {
    position: absolute;
    inset: 0;
    width: 40%;
    border-radius: inherit;
    background: linear-gradient(90deg, #178ac1, #a6d608);
    animation: loader-slide 1.1s ease-in-out infinite;
  }
  @keyframes loader-draw {
    0% { stroke-dashoffset: 1; }
    70%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes loader-settle {
    0% { transform: translateY(14px); opacity: 0; }
    55% { opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  @keyframes loader-slide {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(250%); }
  }
  @keyframes loader-breathe {
    0%, 100% { transform: scale(0.85); opacity: 0.7; }
    50% { transform: scale(1.1); opacity: 1; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    root.classList.add("is-loading");
    var start = Date.now();
    var finished = false;
    function done() {
      if (finished) return;
      finished = true;
      var wait = Math.max(0, 900 - (Date.now() - start)); // avoid a flash on fast loads
      setTimeout(function () {
        var el = document.getElementById("loader");
        if (el) el.classList.add("is-done");
        root.classList.remove("is-loading");
        root.dataset.loaded = "true";
        window.dispatchEvent(new Event("loader:done"));
        setTimeout(function () { if (el) el.remove(); }, 900);
      }, wait);
    }
    if (document.readyState === "complete") done();
    else window.addEventListener("load", done);
    setTimeout(done, 5000); // safety net for slow images
  })();
</script>
