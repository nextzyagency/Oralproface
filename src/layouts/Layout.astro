---
import "../styles/global.css";
import Loader from "../components/Loader.astro";
import { sedes, faqs as faqsHome } from "../data/site";
import { paginas, url } from "../data/paginas";

type Faq = { q: string; a: string };
interface Props {
  title?: string;
  description?: string;
  image?: string;
  faqs?: Faq[];
  extraSchema?: Record<string, unknown>[];
  noindex?: boolean;
}

const site = "https://oralproface.online";
const homeDescription =
  "Oral ProFace: implantes dentales en Colombia con carga inmediata. Dientes fijos en unas 72 horas, incluso con poco hueso. Sedes en Barranquilla y Bogotá.";
const {
  title = "Oral ProFace | Implantes dentales en Colombia en 72 horas",
  description = homeDescription,
  image: imagePath = "/imagenes/hero/imagen1.jpeg",
  faqs = faqsHome,
  extraSchema = [],
  noindex = false,
} = Astro.props;
const image = new URL(imagePath, site).href;
const canonical = new URL(Astro.url.pathname, site).href;
const sedeUrl = (ciudad: string) => {
  const p = paginas.find((x) => x.tipo === "sede" && sedes[x.sede!]?.ciudad === ciudad);
  return p ? `${site}${url(p.slug)}` : `${site}/#contacto`;
};

const regiones = { Barranquilla: "Atlántico", Bogotá: "Bogotá D.C.", Maracaibo: "Zulia" };
const paises = { Colombia: "CO", Venezuela: "VE" };

const direccion = (s: (typeof sedes)[number]) => ({
  "@type": "PostalAddress",
  streetAddress: s.direccion.replace(/\.$/, ""),
  addressLocality: s.ciudad,
  addressRegion: regiones[s.ciudad as keyof typeof regiones],
  addressCountry: paises[s.pais as keyof typeof paises],
});

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["MedicalOrganization", "Dentist"],
      "@id": `${site}/#org`,
      name: "Oral ProFace",
      alternateName: "Oralproface",
      url: site,
      logo: `${site}/imagenes/icon.jpg`,
      image,
      description: homeDescription,
      telephone: "+573008990189",
      email: "oralproimplantes@gmail.com",
      medicalSpecialty: "Dentistry",
      areaServed: [
        { "@type": "Country", name: "Colombia" },
        { "@type": "City", name: "Barranquilla" },
        { "@type": "City", name: "Bogotá" },
        { "@type": "City", name: "Maracaibo" },
      ],
      knowsAbout: [
        "Implantes dentales",
        "Implantes basales",
        "Implantología estratégica",
        "Carga inmediata",
        "Atrofia ósea",
        "Dentadura fija sobre implantes",
      ],
      sameAs: ["https://www.facebook.com/oralpoface", "https://www.instagram.com/oralproface/"],
      founder: { "@id": `${site}/#rixio` },
      address: sedes.map(direccion),
      department: sedes.map((s) => ({
        "@type": "Dentist",
        name: `Oral ProFace ${s.ciudad}`,
        telephone: `+${s.tel.replace(/\s/g, "")}`,
        email: s.email,
        url: sedeUrl(s.ciudad),
        image,
        address: direccion(s),
      })),
      makesOffer: [
        "Implantes dentales basales y estratégicos",
        "Carga inmediata: dientes fijos en 72 horas",
        "Rehabilitación oral completa con dentadura fija sobre implantes",
        "Diseño de sonrisa digital",
      ].map((name) => ({
        "@type": "Offer",
        itemOffered: { "@type": "MedicalProcedure", name },
      })),
    },
    {
      "@type": "Person",
      "@id": `${site}/#rixio`,
      name: "Dr. Rixio Martínez",
      jobTitle: "Odontólogo implantólogo",
      worksFor: { "@id": `${site}/#org` },
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#web`,
      url: site,
      name: "Oral ProFace",
      inLanguage: "es",
      publisher: { "@id": `${site}/#org` },
    },
    ...(faqs.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${canonical}#faq`,
            mainEntity: faqs.map((f) => ({
              "@type": "Question",
              name: f.q,
              acceptedAnswer: { "@type": "Answer", text: f.a },
            })),
          },
        ]
      : []),
    ...extraSchema,
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Oral ProFace" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <meta name="theme-color" content="#0F4C81" />
    <link href="/imagenes/icon.jpg" rel="icon" type="image/jpeg" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..600,0..1,0&display=block"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <style is:global>
      .material-symbols-rounded {
        font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
        line-height: 1;
        user-select: none;
      }
      .icon-fill {
        font-variation-settings: "FILL" 1, "wght" 500, "GRAD" 0, "opsz" 24;
      }
    </style>
  </head>
  <body
    class="font-sans text-slate-600 bg-background-light antialiased overflow-x-clip w-full"
  >
    <Loader />
    <slot />

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Reveal on scroll
      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        const delay = parseFloat(el.dataset.revealDelay || "0");
        gsap.to(el, {
          opacity: 1,
          y: 0,
          duration: reduce ? 0 : 0.9,
          delay,
          ease: "power3.out",
          scrollTrigger: { trigger: el, start: "top 88%", once: true },
        });
      });

      // Parallax (data-speed: positive moves slower, negative faster)
      if (!reduce) {
        gsap.utils.toArray<HTMLElement>("[data-speed]").forEach((el) => {
          const speed = parseFloat(el.dataset.speed || "0");
          gsap.to(el, {
            yPercent: speed * -100,
            ease: "none",
            scrollTrigger: {
              trigger: el.closest("[data-parallax-scope]") || el,
              start: "top bottom",
              end: "bottom top",
              scrub: true,
            },
          });
        });
      }

      // Animated counters
      gsap.utils.toArray<HTMLElement>("[data-count]").forEach((el) => {
        const end = parseFloat(el.dataset.count || "0");
        const obj = { v: 0 };
        gsap.to(obj, {
          v: end,
          duration: reduce ? 0 : 1.8,
          ease: "power2.out",
          scrollTrigger: { trigger: el, start: "top 90%", once: true },
          onUpdate: () => (el.textContent = Math.round(obj.v).toString()),
        });
      });

      window.addEventListener("load", () => ScrollTrigger.refresh());
    </script>
  </body>
</html>
