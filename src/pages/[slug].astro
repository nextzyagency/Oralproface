---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { paginas, tratamientos, sedesPaginas, url, anchor, type Pagina } from "../data/paginas";
import { sedes } from "../data/site";

export function getStaticPaths() {
  return paginas.map((pagina) => ({ params: { slug: pagina.slug }, props: { pagina } }));
}

const { pagina } = Astro.props as { pagina: Pagina };
const site = "https://oralproface.online";
const pageUrl = `${site}${url(pagina.slug)}`;
const sede = pagina.sede !== undefined ? sedes[pagina.sede] : undefined;
const tel = "+573008990189";
const wa = `https://wa.me/573008990189?text=${encodeURIComponent(
  sede
    ? `Hola, deseo agendar una valoración de implantes en ${sede.ciudad}.`
    : `Hola, deseo información sobre ${pagina.nav.toLowerCase()}.`
)}`;
const mapa = sede
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(sede.direccion + " " + sede.ciudad)}`
  : "";
const relacionadas = [...tratamientos, ...sedesPaginas].filter((p) => p.slug !== pagina.slug);

const secciones = pagina.secciones.map((s) => ({ ...s, id: anchor(s.h2) }));
const faqH2 = `Preguntas frecuentes${sede ? ` sobre implantes dentales en ${sede.ciudad}` : ""}`;
const indice = [...secciones.map((s) => ({ id: s.id, label: s.h2 })), { id: "faq", label: "Preguntas frecuentes" }];
const actualizado = new Date(`${pagina.actualizado}T12:00:00`).toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const ctaTitulo = sede ? `Agenda tu valoración en ${sede.ciudad}` : "¿Quieres saber si eres candidato?";
const ctaTexto = sede
  ? `Escríbenos por WhatsApp y elige valoración presencial en ${sede.direccion.replace(/\.$/, "")} o por videollamada.`
  : "Envíanos tu caso por WhatsApp. En la valoración medimos tu hueso con tomografía 3D y te decimos qué plan te conviene, con presupuesto.";

const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/` },
    { "@type": "ListItem", position: 2, name: pagina.nav, item: pageUrl },
  ],
};

const regiones: Record<string, string> = { Barranquilla: "Atlántico", Bogotá: "Bogotá D.C.", Maracaibo: "Zulia" };
const paises: Record<string, string> = { Colombia: "CO", Venezuela: "VE" };
const areaServed: Record<string, string[]> = {
  Maracaibo: ["Maracaibo", "San Francisco", "Cabimas", "Ciudad Ojeda", "Santa Rita"],
  Barranquilla: ["Barranquilla", "Soledad", "Malambo", "Puerto Colombia", "Galapa", "Santa Marta", "Cartagena", "Valledupar"],
  Bogotá: ["Bogotá", "Chía", "Cajicá", "Zipaquirá", "Soacha", "Mosquera", "Funza"],
};
const principal = sede
  ? {
      "@type": "Dentist",
      "@id": `${pageUrl}#sede`,
      name: `Oral ProFace ${sede.ciudad}`,
      url: pageUrl,
      image: `${site}${pagina.imagen}`,
      telephone: tel,
      email: sede.email,
      parentOrganization: { "@id": `${site}/#org` },
      address: {
        "@type": "PostalAddress",
        streetAddress: sede.direccion.replace(/\.$/, ""),
        addressLocality: sede.ciudad,
        addressRegion: regiones[sede.ciudad],
        addressCountry: paises[sede.pais] ?? "CO",
      },
      hasMap: mapa,
      medicalSpecialty: "Dentistry",
      areaServed: (areaServed[sede.ciudad] ?? [sede.ciudad]).map((name) => ({ "@type": "City", name })),
      availableService: tratamientos.map((p) => ({ "@type": "MedicalProcedure", name: p.procedimiento, url: `${site}${url(p.slug)}` })),
    }
  : {
      "@type": "MedicalProcedure",
      "@id": `${pageUrl}#procedimiento`,
      name: pagina.procedimiento,
      description: pagina.intro,
      url: pageUrl,
      bodyLocation: "Maxilar y mandíbula",
    };
const webPage = {
  "@type": "MedicalWebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: pagina.title,
  description: pagina.description,
  inLanguage: "es-CO",
  dateModified: pagina.actualizado,
  isPartOf: { "@id": `${site}/#web` },
  publisher: { "@id": `${site}/#org` },
  about: { "@id": sede ? `${pageUrl}#sede` : `${pageUrl}#procedimiento` },
  breadcrumb,
};
---

<Layout
  title={pagina.title}
  description={pagina.description}
  image={pagina.imagen}
  faqs={pagina.faqs}
  extraSchema={[webPage, principal]}
>
  <Header />
  <main class="bg-background-light">
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 pt-28 sm:pt-32 pb-14 lg:pb-20">
        <nav aria-label="Ruta" class="text-sm text-slate-500">
          <ol class="flex flex-wrap items-center gap-1">
            <li><a href="/" class="hover:text-medical-blue">Inicio</a></li>
            <li aria-hidden="true" class="material-symbols-rounded text-[16px]">chevron_right</li>
            <li aria-current="page" class="text-ink font-medium">{pagina.nav}</li>
          </ol>
        </nav>

        <div class="mt-8 grid lg:grid-cols-12 gap-10 lg:gap-14">
          <div class="lg:col-span-7">
            <h1 class="font-display text-[2.15rem] sm:text-5xl lg:text-[3.35rem] font-bold leading-[1.07] tracking-[-0.025em] text-ink text-balance">
              {pagina.h1}
            </h1>
            <p class="mt-6 max-w-[62ch] text-lg leading-[1.7] text-slate-700">{pagina.intro}</p>
            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <a
                href={wa}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2.5 rounded-full bg-lime px-7 py-3.5 font-bold text-ink transition-colors hover:bg-[#b8e62a]"
              >
                <span class="material-symbols-rounded text-[22px]">chat</span>
                Agendar por WhatsApp
              </a>
              <a
                href={`tel:${tel}`}
                class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-300 px-6 py-3.5 font-semibold text-ink transition-colors hover:border-medical-blue hover:text-medical-blue"
              >
                <span class="material-symbols-rounded text-[20px]">call</span>
                +57 300 8990189
              </a>
            </div>
            <p class="mt-8 text-sm text-slate-500">
              Actualizado el <time datetime={pagina.actualizado}>{actualizado}</time> · Información de Oral ProFace, clínica
              dirigida por el Dr. Rixio Martínez, odontólogo implantólogo.
            </p>
          </div>

          <aside class="lg:col-span-5" aria-label={sede ? "Datos de la sede" : "Ficha del tratamiento"}>
            <img
              src={pagina.imagen}
              alt={pagina.imagenAlt}
              width="800"
              height="600"
              class="w-full aspect-[4/3] rounded-2xl object-cover"
              loading="eager"
              fetchpriority="high"
            />
            <dl class="ficha mt-6">
              {
                pagina.ficha.map((d) => (
                  <div class="grid grid-cols-[8.5rem_1fr] gap-4 py-3">
                    <dt class="text-sm text-slate-500">{d.k}</dt>
                    <dd class="text-[0.95rem] font-medium text-ink">
                      {d.href ? (
                        <a href={d.href} class="underline decoration-primary/40 underline-offset-4 hover:text-medical-blue break-all" target={d.href.startsWith("http") ? "_blank" : undefined} rel="noopener noreferrer">
                          {d.v}
                        </a>
                      ) : (
                        d.v
                      )}
                    </dd>
                  </div>
                ))
              }
            </dl>
            {
              sede && (
                <a href={mapa} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-medical-blue hover:text-primary">
                  <span class="material-symbols-rounded text-[18px]">map</span>
                  Abrir en Google Maps
                </a>
              )
            }
          </aside>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-4 sm:px-8 py-14 lg:py-20 grid lg:grid-cols-12 gap-10 lg:gap-14">
      <nav aria-label="En esta página" class="min-w-0 lg:col-span-3">
        <details class="lg:hidden rounded-2xl bg-medical-gray px-5 py-4">
          <summary class="cursor-pointer font-semibold text-ink">En esta página</summary>
          <ol class="mt-3 space-y-2 text-[0.95rem]">
            {indice.map((i) => <li><a href={`#${i.id}`} class="text-slate-600 hover:text-medical-blue">{i.label}</a></li>)}
          </ol>
        </details>
        <div class="hidden lg:block sticky top-28">
          <p class="text-sm font-semibold text-ink">En esta página</p>
          <ol class="toc mt-4 border-l border-slate-200 text-sm">
            {
              indice.map((i) => (
                <li>
                  <a href={`#${i.id}`} data-toc={i.id} class="-ml-px block border-l border-transparent py-1.5 pl-4 leading-snug text-slate-500 transition-colors hover:text-ink">
                    {i.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </nav>

      <article class="min-w-0 lg:col-span-8 lg:col-start-5 max-w-[68ch]">
        {
          secciones.map((s, n) => (
            <>
              <section id={s.id} class="scroll-mt-28 [&:not(:first-child)]:mt-16">
                <h2 class="font-display text-[1.6rem] sm:text-3xl font-bold leading-tight tracking-[-0.02em] text-ink text-balance">{s.h2}</h2>
                {s.p?.map((t) => <p class="prosa mt-4">{t}</p>)}
                {s.lista && (
                  <ul class="mt-5 space-y-3">
                    {s.lista.map((t) => (
                      <li class="prosa flex gap-3">
                        <span class="mt-[0.7em] h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                        <span>{t}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {s.pasos && (
                  <ol class="regla mt-6">
                    {s.pasos.map((t, k) => (
                      <li class="grid grid-cols-[2.25rem_1fr] gap-3 py-4">
                        <span class="font-display text-lg font-bold tabular-nums text-medical-blue">{k + 1}</span>
                        <span class="prosa">{t}</span>
                      </li>
                    ))}
                  </ol>
                )}
                {s.tabla && (
                  <div class="mt-6 overflow-x-auto">
                    <table class="tabla w-full text-left text-[0.8125rem] leading-snug sm:text-[0.95rem] sm:leading-normal [&_td]:pr-2 [&_th]:pr-2 sm:[&_td]:pr-4 sm:[&_th]:pr-4">
                      <thead>
                        <tr>
                          {s.tabla.cols.map((c, k) => (
                            <th scope="col" class:list={["py-3 font-semibold text-ink", k === (s.tabla!.destacar ?? 1) && "text-medical-blue"]}>
                              {c || <span class="sr-only">Aspecto</span>}
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {s.tabla.filas.map((f) => (
                          <tr>
                            {f.map((c, k) =>
                              k === 0 ? (
                                <th scope="row" class="py-3 align-top font-medium text-slate-500">{c}</th>
                              ) : (
                                <td class:list={["py-3 align-top", k === (s.tabla!.destacar ?? 1) ? "font-medium text-ink" : "text-slate-600"]}>{c}</td>
                              )
                            )}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
                {s.despues?.map((t) => <p class="prosa mt-4">{t}</p>)}
                {s.enlace && (
                  <a href={s.enlace.href} class="mt-5 inline-flex items-center gap-1 font-semibold text-medical-blue underline decoration-primary/40 underline-offset-4 hover:text-primary">
                    {s.enlace.label}
                    <span class="material-symbols-rounded text-[18px]" aria-hidden="true">arrow_forward</span>
                  </a>
                )}
              </section>
              {n === 1 && (
                <aside class="mt-14 rounded-2xl bg-medical-gray p-6 sm:p-7" aria-label="Contacto">
                  <p class="font-display text-xl font-bold text-ink">{ctaTitulo}</p>
                  <p class="prosa mt-2">{ctaTexto}</p>
                  <a href={wa} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 font-semibold text-white transition-colors hover:bg-medical-blue">
                    <span class="material-symbols-rounded text-[20px]">chat</span>
                    Escribir por WhatsApp
                  </a>
                </aside>
              )}
            </>
          ))
        }

        <section id="faq" class="scroll-mt-28 mt-16">
          <h2 class="font-display text-[1.6rem] sm:text-3xl font-bold leading-tight tracking-[-0.02em] text-ink text-balance">{faqH2}</h2>
          <div class="regla mt-6">
            {
              pagina.faqs.map((f, i) => (
                <details class="faq group" open={i === 0}>
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-semibold text-ink">
                    <span class="text-[1.05rem] leading-snug">{f.q}</span>
                    <span class="material-symbols-rounded mt-0.5 shrink-0 text-medical-blue transition-transform duration-300 group-open:rotate-45" aria-hidden="true">add</span>
                  </summary>
                  <p class="prosa -mt-1 pb-6">{f.a}</p>
                </details>
              ))
            }
          </div>
        </section>
      </article>
    </div>

    <section class="bg-ink text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 lg:py-20 grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-7">
          <h2 class="font-display text-3xl sm:text-4xl font-bold leading-tight tracking-[-0.02em] text-balance">{ctaTitulo}</h2>
          <p class="mt-4 max-w-[58ch] text-lg leading-relaxed text-white/75">
            Te respondemos por WhatsApp para elegir fecha. Si vives en otra ciudad o en el exterior, empezamos con una valoración
            online por videollamada.
          </p>
        </div>
        <div class="lg:col-span-5 flex flex-col sm:flex-row lg:justify-end gap-3">
          <a href={wa} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full bg-lime px-7 py-3.5 font-bold text-ink transition-colors hover:bg-white">
            <span class="material-symbols-rounded text-[22px]">chat</span>
            Agendar por WhatsApp
          </a>
          <a href={`tel:${tel}`} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-6 py-3.5 font-semibold text-white transition-colors hover:border-lime hover:text-lime">
            Llamar
          </a>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-14 lg:py-16">
        <h2 class="font-display text-2xl font-bold text-ink">Más sobre implantes en Oral ProFace</h2>
        <ul class="regla mt-6 grid sm:grid-cols-2 sm:gap-x-12">
          {
            relacionadas.map((p) => (
              <li class="border-b border-slate-200">
                <a href={url(p.slug)} class="group flex items-start justify-between gap-4 py-5">
                  <span>
                    <span class="block font-display font-semibold text-ink group-hover:text-medical-blue transition-colors">{p.nav}</span>
                    <span class="mt-1 block text-sm text-slate-500">{p.resumen}</span>
                  </span>
                  <span class="material-symbols-rounded mt-0.5 text-medical-blue transition-transform group-hover:translate-x-1" aria-hidden="true">arrow_forward</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .prosa {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgb(51 65 85);
  }
  /* Signature rule: heavy ink line on top, hairlines between rows (patient-leaflet style) */
  .ficha,
  .regla {
    border-top: 2px solid var(--color-ink);
  }
  .ficha > div + div,
  .regla > li + li,
  .regla > details + details {
    border-top: 1px solid rgb(226 232 240);
  }
  .regla > li.border-b {
    border-top: 0;
  }
  .tabla thead tr {
    border-top: 2px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
  }
  .tabla tbody tr + tr {
    border-top: 1px solid rgb(226 232 240);
  }
  .tabla tbody tr:last-child {
    border-bottom: 1px solid rgb(226 232 240);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .toc a.is-active {
    color: var(--color-ink);
    font-weight: 600;
    border-left-color: var(--color-lime);
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc]"));
  const targets = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.classList.toggle("is-active", a.dataset.toc === e.target.id));
      });
    },
    { rootMargin: "-30% 0px -60% 0px" }
  );
  targets.forEach((t) => io.observe(t));
</script>
