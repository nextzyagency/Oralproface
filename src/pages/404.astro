---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { paginas, url } from "../data/paginas";
---

<Layout title="Página no encontrada | Oral ProFace" description="La página que buscas no existe." faqs={[]} noindex>
  <Header />
  <main class="bg-gradient-to-b from-[#eef6fb] via-white to-background-light">
    <section class="mx-auto max-w-3xl px-5 sm:px-8 pt-36 pb-24 text-center">
      <p class="font-display text-7xl font-bold text-primary/20">404</p>
      <h1 class="mt-4 font-display text-3xl sm:text-4xl font-bold text-ink">Esta página no existe</h1>
      <p class="mt-4 text-lg text-slate-600">Puede que el enlace haya cambiado. Estas son nuestras páginas principales:</p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 text-left">
        <li>
          <a href="/" class="flex items-center justify-between rounded-2xl bg-white border border-slate-100 p-5 font-semibold text-ink hover:border-primary/30 hover:shadow-lg transition-all">
            Inicio <span class="material-symbols-rounded text-primary">arrow_forward</span>
          </a>
        </li>
        {
          paginas.map((p) => (
            <li>
              <a href={url(p.slug)} class="flex items-center justify-between rounded-2xl bg-white border border-slate-100 p-5 font-semibold text-ink hover:border-primary/30 hover:shadow-lg transition-all">
                {p.nav} <span class="material-symbols-rounded text-primary">arrow_forward</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
